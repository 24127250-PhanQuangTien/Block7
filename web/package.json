{
  "name": "restaurant-spa-web",
  "version": "1.0.0",
  "type": "module",
  "description": "Restaurant Single Page Application (SPA) with React, React Router and REST API Integration",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/dish-form.browser.mjs",
    "test:dropdowns": "node tests/dropdowns.browser.mjs",
    "test:presentation": "node tests/presentation.browser.mjs",
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "preview": "vite preview --port 5173"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10"
  }
}
